{
  "name": "@yudream/voxelith-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VMC 管线产物工具链：产物审计（清单/glb/PNG/sha1 一致性）、.vxt 打包与 3D Tiles 导出（CLI: voxelith-forge）",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "bin": {
    "voxelith-forge": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "forge": "node ./dist/cli.js"
  },
  "dependencies": {
    "@yudream/voxelith-core": "workspace:*",
    "@yudream/voxelith-tiles": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
